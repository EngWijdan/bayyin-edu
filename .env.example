# Copy to `.env` for local Docker. Never commit real secrets.

# Django
DJANGO_SECRET_KEY=replace-this-for-staging-and-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Extra browser origins beyond local Flutter web (comma-separated)
# CORS_ALLOWED_ORIGINS=https://app.example.com

# PostgreSQL (compose defaults match these names)
POSTGRES_DB=bayyin
POSTGRES_USER=bayyin
POSTGRES_PASSWORD=bayyin_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery broker (worker is started; OCR and evaluation stay synchronous in the MVP)
REDIS_URL=redis://localhost:6379/0

# Gemini. Evaluation and remediation call Gemini on the server. An empty key
# returns a safe error and does not create AnswerEvaluation rows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
